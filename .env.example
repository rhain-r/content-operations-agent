# Copy to .env and fill in. Every variable is optional except the Anthropic credential.

# --- Claude -------------------------------------------------------------------------------------
# Or leave unset and let the SDK find credentials itself (e.g. after `ant auth login`).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Non-streaming requests are capped at 21000 by the SDK.
ANTHROPIC_MAX_TOKENS=16000

# --- Agency and QA checklist --------------------------------------------------------------------
AGENCY_NAME=Our Agency
# Reference image of the logo (PNG/JPEG/WebP). Strongly recommended: without it Claude only has
# AGENCY_NAME and the description below to recognise the logo.
AGENCY_LOGO_PATH=
AGENCY_LOGO_DESCRIPTION=the agency name as a small wordmark watermark in one corner of the frame
HOOK_DEADLINE_SECONDS=3
DEAD_AIR_THRESHOLD_SECONDS=1

# --- Deconstruction -----------------------------------------------------------------------------
# Videos that would produce more frames than this are rejected at upload (max 100, or 99 with a
# logo reference image, since one request holds at most 100 images).
MAX_FRAMES=100
FRAME_INTERVAL_SECONDS=1
FRAME_LONG_EDGE_PX=1024
# ffmpeg JPEG quality, 2 (best) to 31 (smallest).
FRAME_JPEG_QSCALE=4
CHUNK_PAUSE_SECONDS=0.6
CHUNK_MAX_SECONDS=6
FFMPEG_CMD=ffmpeg
FFPROBE_CMD=ffprobe

# --- Slack (only used with NOTIFIER=slack) ------------------------------------------------------
# Unset = mock mode: failures are logged instead of posted.
SLACK_WEBHOOK_URL=
SLACK_TIMEOUT_SECONDS=10

# --- API ----------------------------------------------------------------------------------------
MAX_UPLOAD_BYTES=524288000
MAX_CONCURRENT_JOBS=2
LOG_LEVEL=INFO

# --- Dashboard ----------------------------------------------------------------------------------
# "none": results only appear in the dashboard. "slack": failures also ping the editor in Slack
# (then the upload form asks for the editor's Slack member ID).
NOTIFIER=none
# Each checked video's file and frames are kept here; older ones are deleted past MAX_STORED_JOBS.
# Job folders found here at startup are removed (the job list itself lives in memory).
MEDIA_DIR=data/jobs
MAX_STORED_JOBS=20
# Add a hand-written example report at startup, so every screen works without an API key.
SEED_EXAMPLE=false
