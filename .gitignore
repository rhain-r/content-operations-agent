# Secrets and local configuration: never commit. .env.example (names and safe defaults only)
# is the one exception.
.env
.env.*
!.env.example

# Checked videos and frames from the live app (MEDIA_DIR); private to this machine.
data/

# Raw videos for the showcase. Only their web copies, exported to docs/, are published.
demo_videos/*
!demo_videos/README.md
demo/

# Python environments and tool caches
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Local editor and assistant settings
.claude/
.vscode/
.idea/

# Partial files from an interrupted export, and OS clutter
*.part.mp4
.DS_Store
Thumbs.db
